{
  "name": "zahra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:auth": "tsx --test tests/customer-auth.test.mts",
    "test:pwa": "tsx --test tests/service-worker.test.mts",
    "test:features": "tsx --test tests/features.test.mts",
    "lint": "eslint",
    "extract": "node scripts/extract.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.mts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.mts",
    "db:upgrade-content": "tsx --env-file-if-exists=.env scripts/upgrade-content.mts",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run db:upgrade-content",
    "test:markdown": "tsx --test tests/markdown.test.mts"
  },
  "dependencies": {
    "@animate-ui/react": "^2.4.1",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.3",
    "marked": "18.1.2",
    "motion": "^14.9.0",
    "next": "16.4.3",
    "radix-ui": "^1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.18.1",
    "server-only": "^0.0.1",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.2",
    "@types/turndown": "5.0.6",
    "cheerio": "^1.2.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
