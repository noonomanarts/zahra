# Database (SQLite file, relative to the project root)
DATABASE_URL=file:storage/zahra.db

# Public URL of the site (used for Paymob redirect and webhook URLs)
APP_URL=http://localhost:3000

# First admin user, created by `npm run db:seed`
ADMIN_EMAIL=admin@zahrasdesignstudio.com
ADMIN_PASSWORD=change-me

# Paymob (Oman) – Dashboard → Settings → API keys / Payment integrations
PAYMOB_API_URL=https://oman.paymob.com
PAYMOB_CHECKOUT_URL=https://om.checkout.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# comma separated integration IDs (card, Apple Pay, …)
PAYMOB_INTEGRATION_IDS=
# amount is sent in the smallest currency unit: OMR has 3 decimals (1 OMR = 1000 baisa)
PAYMOB_AMOUNT_MULTIPLIER=1000
